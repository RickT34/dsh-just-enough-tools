{
  "name": "dsh-just-enough-tools",
  "version": "0.4.2",
  "description": "Progressive tool and skill selection for DeepSeek Harness, powered by Jev",
  "type": "module",
  "exports": {
    ".": "./dist/plugin.js",
    "./scorer": "./dist/scorer.js",
    "./plugin": "./dist/plugin.js",
    "./session": "./dist/session.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "types": "./dist/plugin.d.ts",
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "DESIGN.md",
    "docs",
    "CONTRIBUTING.md",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.check.json && tsc -p tsconfig.client.json",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.3",
    "@deepseek-ai/cordis-plugin-loader": "1.0.4",
    "@deepseek-ai/dsh-agent": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-agent-preset": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-settings": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-skill": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-skill-filesystem": "0.1.7-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-loader": "1.0.4",
    "@deepseek-ai/dsh-agent-loop": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-agent-preset": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-agent-preset-registry": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-api-remotes": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-locale": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-store": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-session-projection": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-settings": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-skill": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-skill-filesystem": "0.1.7-alpha.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.1",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "jev",
    "agent",
    "tool-routing",
    "tool-use",
    "skills",
    "capability-routing"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.3"
  }
}
